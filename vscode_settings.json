    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editor.defaultBinaryEditor": "jupyter-notebook",
    "workbench.settings.applyToAllProfiles": [
        "editor.fontSize",
        "editor.fontFamily",
        "files.autoSave"
    ],
    "workbench.iconTheme": "vira-icons-teal",
    "window.titleBarStyle": "custom",
    "zenMode.restore": true,
    "zenMode.centerLayout": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.fullScreen": true,
    "zenMode.hideStatusBar": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "always",
        "source.unusedImports": "always"
    },
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.lineNumbers": "relative",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.rulers": [120],
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.guides.bracketPairs": true,
    "editor.accessibilitySupport": "off",
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "expand",
    "editor.fontLigatures": true,
    "editor.fontFamily": "FiraCode Nerd Font Mono",
    "editor.fontSize": 13,
    "editor.codeLensFontFamily": "FiraCode Nerd Font Mono",
    "editor.formatOnPaste": true,
    "editor.minimap.autohide": "mouseover",
    "files.autoSave": "onFocusChange",
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "explorer.compactFolders": false,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120,
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[dockerfile]": {
        "editor.quickSuggestions": {
            "strings": true
        }
    },
    "[django-html]": {
        "editor.quickSuggestions": {
            "other": true,
            "comments": true,
            "strings": true
        }
    },
    "[css]": {
        "editor.suggest.insertMode": "replace",
        "cSpell.fixSpellingWithRenameProvider": false
    },
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash"
        },
        "Ubuntu-22.04 (WSL)": {
            "path": "C:\\WINDOWS\\System32\\wsl.exe",
            "args": ["-d", "Ubuntu-22.04"]
        },
        "tmux-shell": {
            "path": "tmux",
            "args": ["new", "-A", "-s", "vscode:${workspaceFolder}"]
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.profiles.osx": {
        "bash": {
            "path": "bash",
            "args": ["-l"],
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh",
            "args": ["-l"]
        },
        "fish": {
            "path": "fish",
            "args": ["-l"]
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux",
            "args": ["new-session", "-A", "-s", "vscode.${workspaceFolder}"]
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "git.confirmSync": false,
    "vim.enableNeovim": true,
    "vim.useSystemClipboard": true,
    "vim.history": 1000,
    "vim.leader": "space",
    "vim.neovimUseConfigFile": true,
    "vim.neovimConfigPath": "~/.config/nvim/init.lua",
    "vim.neovimPath": "/opt/homebrew/bin/nvim",
    "vim.textwidth": 120,
    "vim.highlightedyank.enable": true,
    "vim.easymotion": true,
    "vim.useCtrlKeys": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "t"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.terminal.focus"
                }
            ]
        },
        {
            "before": ["<leader>", "u"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.focusActiveEditorGroup"
                }
            ]
        },
        {
            "before": ["<leader>", "p"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.quickOpen"
                }
            ]
        },
        {
            "before": ["<leader>", "i", "t"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.terminal.toggleTerminal"
                }
            ]
        },
        {
            "before": ["<leader>", "v", "s"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.splitEditor"
                }
            ]
        },
        {
            "before": ["<leader>", "h"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.focusFirstEditorGroup"
                }
            ]
        },
        {
            "before": ["<leader>", "l"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.focusSecondEditorGroup"
                }
            ]
        },
        {
            "before": ["<leader>", "w"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.closeActiveEditor"
                }
            ]
        }
    ],
    "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.allowUnauthorizedRemoteConnection": true,
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "jupyter.interactiveWindow.textEditor.magicCommandsAsComments": true,
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
    "interactiveWindow.executeWithShiftEnter": true,
    "python.languageServer": "Ruff Language Server",
    "ruff.lineLength": 120,
    "ruff.lint.enable": true,
    "ruff.organizeImports": true,
    "ruff.path":["/usr/bin/ruff"],
    "ruff.showSyntaxErrors": true,
    "cmake.configureOnOpen": true,
    "cSpell.userWords": ["Balena", "Vigneswar"],
